{
  "name": "server",
  "version": "1.0.27",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "dev": "node main.js",
    "build:launcher": "node tools/build-launcher.cjs launcher-dist",
    "package:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./tools/package-release.ps1",
    "build:modifications": "node ./tools/build-modifications.cjs",
    "test:modifications": "node ./tools/test-modifications.cjs",
    "test:planning-data": "node --test tools/test-planning-rules.cjs",
    "sync:web-assets": "node tools/sync-web-assets.cjs",
    "check:web-assets": "node tools/sync-web-assets.cjs --check",
    "test:web-assets": "node --test tools/test-web-assets.cjs",
    "test:browser": "node tools/check-wheel.cjs && node tools/check-web-cache.cjs && node tools/check-tree-retry.cjs && node tools/check-site-locales.cjs && node tools/check-calculation-consistency.cjs && node tools/check-game-roster-additions.cjs && npm run test:browser:recovery",
    "test:browser:recovery": "node tools/check-export-controls.cjs && node tools/check-export-hd.cjs && node tools/check-plan-backup.cjs && node tools/check-plan-concurrency.cjs",
    "test:wiki-refresh": "node --test tools/test-wiki-refresh-guard.cjs tools/test-update-security.cjs",
    "test:security": "node --test tools/test-server-security.cjs tools/test-update-security.cjs tools/test-proxy-addr-security.cjs",
    "test:wiki-http": "node --test tools/test-wiki-http.cjs",
    "test:launcher-security": "node tools/check-launcher-policy.cjs",
    "check:dependencies": "node tools/check-dependency-inventory.cjs",
    "audit:dependencies": "node tools/check-dependency-inventory.cjs --audit",
    "audit:vendored": "node tools/check-dependency-inventory.cjs --audit-vendored",
    "audit:dotnet": "node tools/check-dependency-inventory.cjs --audit-dotnet",
    "audit:assets": "node tools/check-dependency-inventory.cjs --audit-assets",
    "test:assets": "node --test tools/test-static-assets.cjs",
    "check:actions": "node tools/audit-github-actions.cjs --check",
    "audit:actions": "node tools/check-dependency-inventory.cjs --audit-actions",
    "test:actions": "node --test tools/test-github-actions.cjs",
    "test:dependency-inventory": "node --test tools/test-dependency-inventory.cjs tools/test-vendored-dependencies.cjs tools/test-dotnet-dependencies.cjs",
    "pull": "node ./src/4-fill_tree_details.js",
    "pull:usa-ground": "node ./src/4-fill_tree_details.js usa ground"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "War Thunder TreeData-Test-App",
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "express": "^5.2.1",
    "js-beautify": "^2.0.3",
    "module-alias": "^2.3.4"
  },
  "devDependencies": {
    "css-tree": "3.2.1",
    "playwright": "1.64.1",
    "saxes": "6.0.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "_moduleAliases": {
    "@": "",
    "@output": "output",
    "@dict": "dict"
  }
